---
interface Props {
  lang: 'en' | 'pt';
  enHref: string;
  ptHref: string;
  homeHref: string;
}
const { lang, enHref, ptHref, homeHref } = Astro.props;
---

<header class="header">
  <a class="logo" href={homeHref} aria-label="Carolina Cajazeira — home">
    <img src="/logo.png" width="67" height="28" alt="CAJÁ" />
  </a>
  <div class="lang-toggle" role="group" aria-label="Language">
    {lang === 'en' ? (
      <span class="lang-current" aria-current="true">EN</span>
    ) : (
      <a class="lang-other" href={enHref}>EN</a>
    )}
    <span class="lang-sep" aria-hidden="true"></span>
    {lang === 'pt' ? (
      <span class="lang-current" aria-current="true">PT</span>
    ) : (
      <a class="lang-other" href={ptHref}>PT</a>
    )}
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px var(--page-padding);
    background: var(--color-bg);
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    display: block;
    height: 24px;
    width: auto;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: var(--radius-pill);
  }

  .lang-current,
  .lang-other {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: 16px;
  }

  .lang-current {
    font-weight: 700;
    color: var(--color-text-strong);
  }

  .lang-other {
    font-weight: 400;
    color: var(--color-text-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .lang-other:hover {
    color: var(--color-text-strong);
    background: var(--color-surface);
  }

  .lang-sep {
    width: 1px;
    height: 12px;
    background: var(--color-border);
  }

  @media (max-width: 640px) {
    .header {
      padding: 12px var(--page-padding);
    }
  }
</style>
