---
import BackButton from './BackButton.astro';
import ImageBlock from './ImageBlock.astro';
import ImageGallery from './ImageGallery.astro';
import ProjectDetails from './ProjectDetails.astro';
import SplitSection from './SplitSection.astro';
import Divider from './Divider.astro';
import SectionHeader from './SectionHeader.astro';
import RelatedProjectCard from './RelatedProjectCard.astro';
import ContactButton from './ContactButton.astro';
import type { CaseStudyCopy } from '../content/caseStudies';

interface Props {
  copy: CaseStudyCopy;
}
const { copy } = Astro.props;
const homeHref = copy.lang === 'en' ? '/' : '/pt/';
const projectHrefPrefix = homeHref;
---

<section class="headline">
  <div class="intro">
    <BackButton href={homeHref} label={copy.backLabel} />
    <div class="carol">
      <h1>{copy.title}</h1>
      <div class="labels">
        <span>{copy.client}</span>
        <span aria-hidden="true">・</span>
        <span>{copy.category}</span>
        <span aria-hidden="true">・</span>
        <span>{copy.year}</span>
      </div>
    </div>
    <p class="summary">{copy.summary}</p>
  </div>
</section>

<ImageBlock src={copy.heroImage1} alt={copy.title} accent={copy.accent} />

<ProjectDetails details={copy.details} />

<SplitSection label={copy.problem.label}>
  <p>{copy.problem.body}</p>
</SplitSection>

<SplitSection label={copy.solution.label}>
  <p>{copy.solution.body}</p>
</SplitSection>

<SplitSection label={copy.impact.label}>
  <p>{copy.impact.body}</p>
</SplitSection>

<SplitSection label={copy.keyInsightsSummary.label}>
  <p>{copy.keyInsightsSummary.body}</p>
</SplitSection>

<ImageBlock src={copy.heroImage2} alt={copy.insight1.title} accent={copy.accent} />

<SplitSection label={copy.insight1.label} divider={false}>
  <h3>{copy.insight1.title}</h3>
  <p>{copy.insight1.body}</p>
</SplitSection>

{copy.gallery ? (
  <ImageGallery images={copy.gallery} alt={copy.insight1.title} accent={copy.accent} />
) : copy.insight1Image ? (
  <ImageBlock
    src={copy.insight1Image}
    aspectRatio={copy.insight1ImageAspectRatio}
    alt={copy.insight1.title}
    accent={copy.accent}
  />
) : null}

<SplitSection label={copy.insight2.label}>
  <h3>{copy.insight2.title}</h3>
  <p>{copy.insight2.body}</p>
</SplitSection>

<ImageBlock src={copy.heroImage3} alt={copy.insight2.title} accent={copy.accent} />

<SplitSection label={copy.insight3.label}>
  <h3>{copy.insight3.title}</h3>
  <p>{copy.insight3.body}</p>
</SplitSection>

<ImageBlock
  src={copy.heroImage4}
  video={copy.heroVideo4}
  videoWebm={copy.heroVideo4Webm}
  poster={copy.heroVideo4Poster}
  alt={copy.insight3.title}
  accent={copy.accent}
/>

<SplitSection label={copy.results.label} bottomPadding={120}>
  <ul>
    {copy.results.items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</SplitSection>

<section class="more-projects">
  <SectionHeader title={copy.moreProjectsTitle} />
  <div class="related-list">
    {copy.relatedProjects.map((project) => (
      <RelatedProjectCard project={project} href={`${projectHrefPrefix}${project.slug}`} />
    ))}
  </div>
</section>

<section class="contact">
  <Divider />
  <div class="contact-row">
    <h2>{copy.contactTitle}</h2>
    <div class="contact-items">
      {copy.contact.map((c) => (
        <ContactButton label={c.label} href={c.href} icon={c.icon} />
      ))}
    </div>
  </div>
</section>

<style>
  section {
    width: 100%;
    padding-left: var(--page-padding);
    padding-right: var(--page-padding);
  }

  .headline {
    display: flex;
    justify-content: center;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .carol {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-case-title);
    line-height: 1.3;
    color: var(--color-text);
  }

  .labels {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-label);
    flex-wrap: wrap;
  }

  .summary {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .more-projects {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 40px;
    padding-bottom: 64px;
    border-top: 1px solid var(--color-divider);
  }

  .related-list {
    display: flex;
    gap: 40px;
    width: 100%;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-bottom: 64px;
  }

  .contact-row {
    display: flex;
    gap: 48px;
    align-items: center;
    width: 100%;
  }

  .contact-row h2 {
    margin: 0;
    flex-shrink: 0;
    width: 220px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section-title);
    line-height: 1.5;
    color: var(--color-text);
  }

  .contact-items {
    display: flex;
    flex: 1 1 0;
    gap: 24px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .related-list {
      flex-direction: column;
    }

    .contact-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .contact-row h2 {
      width: auto;
    }

    .contact-items {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .contact-items {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
