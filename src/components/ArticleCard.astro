---
import type { ArticleCopy } from '../content/copy';

interface Props {
  article: ArticleCopy;
  href?: string;
}
const { article, href = '#' } = Astro.props;
---

<a class="article-card" href={href}>
  <img class="thumb" src="/assets/thumb-article.png" alt="" aria-hidden="true" loading="lazy" />
  <div class="info">
    <div class="labels">
      <span>{article.readTime}</span>
      <span aria-hidden="true">・</span>
      <span>{article.date}</span>
      <span aria-hidden="true">・</span>
      <span>{article.tags}</span>
    </div>
    <h3>{article.title}</h3>
    <p>{article.excerpt}</p>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    align-items: center;
    gap: 48px;
    width: calc(100% + 32px);
    margin: 0 -16px;
    padding: 40px 16px;
    background-color: transparent;
    transition: background-color 0.15s ease;
  }

  .article-card:hover,
  .article-card:active,
  .article-card:focus-visible {
    background-color: var(--color-surface-hover);
  }

  .thumb {
    flex-shrink: 0;
    width: 220px;
    height: 140px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
  }

  .info {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .labels {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-label);
    text-transform: uppercase;
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-card-title);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  p {
    margin: 0;
    font-size: var(--text-card-body);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .article-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .thumb {
      width: 100%;
      height: 160px;
    }
  }
</style>
