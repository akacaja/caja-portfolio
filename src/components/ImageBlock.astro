---
interface Props {
  src?: string;
  video?: string;
  videoWebm?: string;
  poster?: string;
  alt?: string;
  accent?: 'blue' | 'green' | 'sage';
}
const { src, video, videoWebm, poster, alt = '', accent = 'blue' } = Astro.props;
---

<div class="image-block">
  {video ? (
    <video poster={poster} autoplay loop muted playsinline preload="metadata" aria-label={alt}>
      {videoWebm && <source src={videoWebm} type="video/webm" />}
      <source src={video} type="video/mp4" />
    </video>
  ) : src ? (
    <img src={src} alt={alt} loading="lazy" />
  ) : (
    <div class:list={['placeholder', `placeholder--${accent}`]} aria-hidden="true"></div>
  )}
</div>

<style>
  .image-block {
    width: 100%;
    padding: 40px var(--page-padding);
  }

  .image-block img,
  .image-block video,
  .placeholder {
    width: 100%;
    aspect-ratio: 1192 / 670;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
  }

  .placeholder--blue {
    background: var(--color-accent-blue);
  }
  .placeholder--green {
    background: var(--color-accent-green);
  }
  .placeholder--sage {
    background: var(--color-accent-sage);
  }

  @media (max-width: 640px) {
    .image-block {
      padding: 24px var(--page-padding);
    }
  }
</style>
