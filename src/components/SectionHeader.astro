---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="section-header">
  <h2>{title}</h2>
</div>

<style>
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section-title);
    line-height: 1.3;
    color: var(--color-text);
  }
</style>
