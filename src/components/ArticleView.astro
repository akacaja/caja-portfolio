---
import BackButton from './BackButton.astro';
import Divider from './Divider.astro';
import ContactButton from './ContactButton.astro';
import Icon from './Icon.astro';
import type { ArticleCopy } from '../content/articles';

interface Props {
  copy: ArticleCopy;
}
const { copy } = Astro.props;
const homeHref = copy.lang === 'en' ? '/' : '/pt/';
---

<section class="headline">
  <div class="intro">
    <BackButton href={homeHref} label={copy.backLabel} />
    <div class="carol">
      <h1>{copy.title}</h1>
      <div class="labels">
        <span>{copy.date}</span>
        <span aria-hidden="true">・</span>
        <span>{copy.readTime}</span>
        <span aria-hidden="true">・</span>
        <span>{copy.tags}</span>
      </div>
    </div>
    <p class="summary">{copy.subtitle}</p>
  </div>
</section>

<article class="body">
  {copy.body.map((block) => {
    if (block.type === 'heading') {
      return <h2>{block.text}</h2>;
    }
    if (block.type === 'paragraph') {
      return <p>{block.text}</p>;
    }
    if (block.type === 'list') {
      return (
        <ul>
          {block.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      );
    }
    if (block.type === 'image') {
      return (
        <figure class="media">
          <img src={block.src} alt={block.alt} style={`aspect-ratio: ${block.aspectRatio}`} loading="lazy" />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );
    }
    return null;
  })}
  <a class="source-link" href={copy.sourceHref} target="_blank" rel="noopener noreferrer">
    <Icon name="medium" size={16} />
    <span>{copy.sourceLabel}</span>
  </a>
</article>

<section class="contact">
  <Divider />
  <div class="contact-row">
    <h2>{copy.contactTitle}</h2>
    <div class="contact-items">
      {copy.contact.map((c) => (
        <ContactButton label={c.label} href={c.href} icon={c.icon} />
      ))}
    </div>
  </div>
</section>

<style>
  section,
  .body {
    width: 100%;
    padding-left: var(--page-padding);
    padding-right: var(--page-padding);
  }

  .headline {
    display: flex;
    justify-content: center;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .carol {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-case-title);
    line-height: 1.3;
    color: var(--color-text);
  }

  .labels {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-label);
    flex-wrap: wrap;
  }

  .summary {
    margin: 0;
    max-width: 760px;
    font-size: var(--text-body);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--color-text-muted);
    font-size: var(--text-label);
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .source-link:hover {
    color: var(--color-text);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 8px;
    padding-bottom: 40px;
  }

  .body :global(h2) {
    margin: 32px 0 0;
    max-width: 760px;
    width: 100%;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-insight-title);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .body :global(p) {
    margin: 0;
    max-width: 760px;
    width: 100%;
    font-size: var(--text-body);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .body :global(ul) {
    margin: 0;
    max-width: 760px;
    width: 100%;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .body :global(li) {
    font-size: var(--text-body);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .body :global(.media) {
    margin: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .body :global(.media img) {
    width: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
  }

  .body :global(.media figcaption) {
    margin: 0;
    max-width: 760px;
    width: 100%;
    text-align: left;
    font-size: var(--text-label);
    color: var(--color-text-muted);
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-bottom: 64px;
    padding-top: 24px;
  }

  .contact-row {
    display: flex;
    gap: 48px;
    align-items: center;
    width: 100%;
  }

  .contact-row h2 {
    margin: 0;
    flex-shrink: 0;
    width: 220px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-section-title);
    line-height: 1.5;
    color: var(--color-text);
  }

  .contact-items {
    display: flex;
    flex: 1 1 0;
    gap: 24px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .contact-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .contact-row h2 {
      width: auto;
    }

    .contact-items {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .contact-items {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
      gap: 12px;
    }
  }
</style>
