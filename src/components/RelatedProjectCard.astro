---
import type { ProjectCopy } from '../content/copy';

interface Props {
  project: ProjectCopy;
  href: string;
}
const { project, href } = Astro.props;
---

<a class="related-card" href={href}>
  <img
    class:list={['thumb', `thumb--${project.accent}`]}
    src={`/assets/thumb-${project.thumb}.png`}
    alt=""
    aria-hidden="true"
    loading="lazy"
  />
  <div class="info">
    <div class="labels">
      <span>{project.client}</span>
      <span aria-hidden="true">・</span>
      <span>{project.category}</span>
      <span aria-hidden="true">・</span>
      <span>{project.year}</span>
    </div>
    <h3>{project.title}</h3>
  </div>
</a>

<style>
  .related-card {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    gap: 32px;
    padding: 40px 16px;
    background-color: transparent;
    transition: background-color 0.15s ease;
  }

  .related-card:hover,
  .related-card:active,
  .related-card:focus-visible {
    background-color: var(--color-surface-hover);
  }

  .thumb {
    width: 100%;
    aspect-ratio: 544 / 346;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .thumb--blue {
    background: var(--color-accent-blue);
  }
  .thumb--green {
    background: var(--color-accent-green);
  }
  .thumb--sage {
    background: var(--color-accent-sage);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .labels {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-label);
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-card-title);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .related-card {
      padding: 24px 0;
    }
  }
</style>
