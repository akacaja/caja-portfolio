---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyView from '../../components/CaseStudyView.astro';
import { documents } from '../../content/caseStudies';

const copy = documents.pt;
---

<BaseLayout
  lang="pt"
  title={`${copy.title} — Carolina Cajazeira`}
  description={copy.summary}
  enHref="/documents"
  ptHref="/pt/documents"
  footerRole={copy.footerRole}
  footerClockSuffix={copy.footerClockSuffix}
>
  <CaseStudyView copy={copy} />
</BaseLayout>
